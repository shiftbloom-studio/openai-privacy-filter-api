# API
PRIVACY_FILTER_MODEL_ID=openai/privacy-filter
PRIVACY_FILTER_MODEL_PATH=
PRIVACY_FILTER_RUNTIME=local
PRIVACY_FILTER_CORS_ORIGINS=http://localhost:3000,https://privacy.shiftbloom.studio
PRIVACY_FILTER_INTERNAL_TOKEN=
HF_HOME=.hf-cache

# Web
PRIVACY_FILTER_API_URL=http://localhost:8000
PRIVACY_FILTER_INTERNAL_TOKEN=

# Runtime selection: browser (default, no server compute) or server (FastAPI).
NEXT_PUBLIC_PRIVACY_FILTER_RUNTIME=browser

# Operator details for the Impressum and privacy policy (build time).
# Address lines are separated with "|".
NEXT_PUBLIC_OPERATOR_NAME=Example Studio
NEXT_PUBLIC_OPERATOR_REPRESENTATIVE=Jane Doe
NEXT_PUBLIC_OPERATOR_ADDRESS=Example Street 1|12345 Example City|Germany
NEXT_PUBLIC_OPERATOR_EMAIL=hello@example.com
NEXT_PUBLIC_OPERATOR_AUTHORITY=Example Data Protection Authority, Example Street 2, 12345 Example City
NEXT_PUBLIC_OPERATOR_LOCATION=Example City, Germany
